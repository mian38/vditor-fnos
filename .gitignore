# ===== 构建产物 =====
*.fpk
*.pyc
__pycache__/
.verify_pkg/

# 历史版本快照：体积大（115MB）且源码可用 Git 历史还原，不随仓库分发。
# 本地保留供回溯，仓库侧只保留必要的说明（见 ARCHIVE.md）。
archive/

# ===== 第三方可执行文件（需从飞牛官方获取，不随仓库分发）=====
fnpack.exe

# ===== AI 协作私有记忆（含内部 commit hash 与工作记录，不应公开）=====
.workbuddy/

# ===== WorkBuddy 会话/草稿导出（含本机路径与内部推理，禁止提交）=====
# 匹配 vditor_full_conversation_*.md、*_devstory_*.md 等由 AI 会话导出的文件。
# 这些是本地工作产物，不应进入仓库或被推送。
*_conversation*.md
*_devstory*.md

# ===== 内部审计与运维指引（含账号/凭据相关，禁止提交）=====
COMPLIANCE_AUDIT_*.md
PUSH_GUIDE.md

# ===== IDE / 编辑器 =====
.idea/
.vscode/
*.swp
*.swo
*~
*.bak
*.orig
*.rej

# ===== 日志与临时文件 =====
*.log
.DS_Store
Thumbs.db
desktop.ini

# Windows 保留设备名：测试脚本里的 `2>nul` 重定向在 Git Bash 下会真的创建名为
# nul 的文件（Linux 上则是丢弃输出）。该文件无法用普通 rm / 安全删除机制处理
# （DeleteFileW 返回 err=5），故只能忽略。需清理时用：
#   python -c "import os;os.remove(r'\\\\?\\'+os.path.abspath('nul'))"
# 或在资源管理器中以 \\?\ 前缀操作。
/nul

# ===== 环境变量与本地配置（含密码，禁止提交）=====
.env
*.env.local
config.local.*

# ===== 本地工作产物（开发时保留，不对外开源）=====
# 审计前的临时备份（仅本地回滚用）
_audit_backup/
# 审计/评审/诊断类说明文档：由 AI 与开发过程产生，非仓库必需，随工作区保留即可。
# 故不放在仓库根目录，也不进入 git —— 避免误导外部读者、泄露内部实现细节。
_local_docs/
