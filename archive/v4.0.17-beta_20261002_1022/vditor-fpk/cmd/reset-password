#!/bin/bash
# cmd/reset-password —— 在 NAS 终端一键重置 Vditor 访问密码
# 原理：删除密码文件 pwhash，重启应用后页面出现「首次设置密码」页，重设即可。
# 文档数据（在 var/docs 或共享文件夹）完全不受影响。
set -u

CFG="${VDITOR_CONFIG:-${TRIM_PKGETC:-}}"

# 若环境变量未注入（直接在系统终端执行），则在常见数据盘搜索 pwhash
if [ -z "$CFG" ] || [ ! -f "$CFG/pwhash" ]; then
  hits=$(find /vol1 -name pwhash -type f 2>/dev/null)
  if [ -z "$hits" ]; then
    hits=$(find / -name pwhash -type f 2>/dev/null | grep -v '^/proc/')
  fi
  n=$(printf '%s\n' "$hits" | grep -c .)
  if [ "$n" -eq 0 ]; then
    echo "未找到 pwhash 文件，可能尚未设置密码，无需重置。"
    exit 0
  elif [ "$n" -eq 1 ]; then
    CFG="$(dirname "$hits")"
  else
    echo "找到多个 pwhash 文件，请手动删除其中一个："
    printf '%s\n' "$hits"
    exit 1
  fi
fi

rm -f "$CFG/pwhash"
echo "已删除密码文件：$CFG/pwhash"
echo "请到飞牛『应用中心』停止并重新启动本应用（或执行该应用的停止 / 启动）。"
echo "重启后打开页面将出现『首次设置密码』页，设置新密码即可。文档数据不受影响。"
