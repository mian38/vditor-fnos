#!/bin/bash
# cmd/uninstall_init —— 卸载前：停止运行中的服务
# 注：卸载时是否清除应用数据由本应用「设置→维护」中的开关控制，由 uninstall_callback 读取
# @appconf/settings.json 决定；卸载向导仅作静态说明，不含应用实时状态。
set -u
APP_DIR="${TRIM_APPDEST}"
PID_FILE="${TRIM_PKGVAR}/vditor.pid"
if [ -f "$PID_FILE" ]; then
  p="$(cat "$PID_FILE" 2>/dev/null | tr -d '[:space:]')"
  [ -n "$p" ] && kill "$p" 2>/dev/null
  rm -f "$PID_FILE"
fi
pkill -f "${APP_DIR}/server.py" 2>/dev/null
exit 0
