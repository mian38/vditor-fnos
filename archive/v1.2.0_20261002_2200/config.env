# Vditor NAS 配置文件
# 修改后重启服务生效： systemctl restart vditor-nas
# 或直接： pkill -f server.py && python3 /opt/vditor-nas/server.py &

# 浏览器访问端口（飞牛防火墙需放行此端口）
PORT=9000

# 监听地址：0.0.0.0 表示允许局域网/公网访问；127.0.0.1 仅本机
HOST=0.0.0.0

# ============ 以下为可选配置（注释掉即使用默认值）============

# 多文件夹分区：名称::路径 用逗号分隔，可指定多个可访问文件夹，每文件夹独立分区、互不混淆。
# 例如： 工作笔记::/vol1/share/Notes, 个人随笔::/vol1/share/Essays
# 优先级最高；不设置时，飞牛环境自动使用「访问权限」授权目录与 data-share 共享目录。
# VDITOR_DOC_DIRS=工作笔记::/vol1/share/Notes,个人随笔::/vol1/share/Essays

# 单文档目录回退（当未配置 VDITOR_DOC_DIRS 且无访问权限目录时使用）
# VDITOR_DOC_DIR=/opt/vditor-nas/docs

# 上传文件存放目录
# VDITOR_UPLOAD_DIR=/opt/vditor-nas/uploads

# 密码：直接预置明文密码（仅建议自动部署使用；留空则首次访问需在网页设置管理员密码）
# 注意：明文写在配置中不够安全，生产环境建议留空，改由首次设置页设定。
# VDITOR_PASSWORD=changeme

# 预置 PBKDF2 密码哈希（优先级高于 VDITOR_PASSWORD），格式：pbkdf2_sha256$<iters>$<salt_hex>$<hash_hex>
# 留空即可，由首次设置页生成并写入配置目录的 pwhash 文件。
# VDITOR_PWHASH=

# 配置目录（存放密码哈希 pwhash 文件）；默认使用 VDITOR_CONFIG 或 BASE_DIR
# VDITOR_CONFIG=/opt/vditor-nas

# 信任反向代理：置 1 时从 X-Forwarded-For 取真实客户端 IP（用于防爆破计数与会话绑定）。
# 经内网穿透/反向代理且代理会正确覆盖 X-Forwarded-For 时建议开启。
# VDITOR_TRUST_PROXY=0

# Cookie Secure 标记：置 1 时强制 Set-Cookie 带 Secure（全站 HTTPS 时建议开启）
# VDITOR_SECURE_COOKIE=0
