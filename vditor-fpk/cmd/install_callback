#!/bin/bash
# cmd/install_callback —— 安装后：固定端口落盘、端口占用校验、诊断日志、建立终端命令软链
#
# ============ 1.2.3 变更说明 ============
# 本脚本在 1.2.2 曾包含四段与「安装向导自定义端口/文档目录」相关的逻辑，1.2.3 全部移除：
#
#   1. 端口三级取值（向导变量 → 已有 port 文件 → 默认 3838）
#      移除原因：安装向导自 1.2.3 起不再提供端口字段，取值链路的输入端已消失。
#      端口固定为 3838（与 manifest service_port 及桌面图标一致）。
#
#   2. sync_icon_port()（改 target/ui/config 的 port 字段）
#      移除原因：**已实测证伪**。真机验证（fnOS 1.2.2）确认桌面图标跳转地址
#      并不读取 target/ui/config，而是取自应用中心 PostgreSQL appcenter 库的
#      app 表（安装时一次性写入）。改文件无效、重启 trim_app_center.service
#      亦无效。该逻辑属「静默失效」典型形态——制造了"已同步端口"的假象，
#      却在日志与返回值上都表现为成功。社区自 2024 年起多人遇到，无官方解法。
#      详见 CHANGELOG.md 1.2.3 条目。
#
#   3. doc_dir 文件写入
#      移除原因：安装向导自 1.2.2 起已不再提供 doc_dir 字段，该段在新装时从不执行。
#      已存在的 doc_dir 文件由 cmd/main 继续读取（兼容老安装），此处不再维护。
#
#   4. folders.json + doc_partition_name 落盘
#      移除原因：同上，向导已不提供该字段，变量恒为空导致整块被 if 跳过。
#      文档分区统一由应用内「设置 → 文件夹」管理（写入同一份 folders.json）。
#
# 保留的部分（经 1.2.2 三轮真机排查验证有实际价值）：
#   · 环境变量诊断日志 —— 真机出问题的第一手材料
#   · 端口占用硬校验 —— 占用时当场中止，而非装完才发现打不开
#   · bin/vditor 软链与服务重启
set -u

# ============ 诊断输出 ============
# 背景：本脚本曾因「向导变量名与读取名不一致」长期静默失效——wizard/install 里
# field 写的是 app_port，fnOS 注入的环境变量也叫 app_port（**环境变量名 = field 原名，
# 系统不会自动补 wizard_ 前缀**，见官方文档《用户向导》/《环境变量》），
# 而本脚本读的是 wizard_app_port → 恒为空 → 端口被静默回退成默认值 3838。
# 那次排查最耗时的环节就是"日志里看不到任何变量"，故保留此诊断输出。
LOGF="${TRIM_TEMP_LOGFILE:-/dev/null}"
{
  echo "=== vditor install_callback 诊断 ==="
  echo "TRIM_APP_STATUS=${TRIM_APP_STATUS:-<空>}"
  echo "TRIM_PKGETC=${TRIM_PKGETC:-<空>}"
  echo "TRIM_APPDEST=${TRIM_APPDEST:-<空>}"
  echo "TRIM_APPNAME=${TRIM_APPNAME:-<空>} ${TRIM_APPVER:-<空>}"
  echo "---- 全部环境变量 ----"
  env | sort
} >> "$LOGF" 2>/dev/null || true

CONFIG_DIR="${TRIM_PKGETC}"
PORT_FILE="${CONFIG_DIR}/port"

# 固定端口 3838：与 manifest 的 service_port 及桌面图标跳转地址保持一致。
# 用户若需改端口，须同步修改 manifest service_port 并重新打包——
# 单独改本文件不会改变桌面图标的跳转地址（原因见文件头 sync_icon_port 说明）。
PORT=3838

# 端口占用检测（1.2.2 引入，1.2.3 保留）。
# 检测到占用即中止安装并给出可执行提示——此前只 echo 一行就继续装，
# 用户装完才发现图标跳过去打不开，排查成本远高于安装时直接拦下。
# install_callback 以非零退出可中止安装，官方文档说明 TRIM_TEMP_LOGFILE
# 的内容会展示给用户，故文案需自包含（含重试指引）。
#
# 必须做多路兜底：只判 command -v ss 的话，目标系统一旦没有 ss（精简环境 /
# 容器 / 某些 NAS 固件），整段校验会被静默跳过——正是本项目反复吃过的
# 「静默失效」套路。三条路径任一可用即生效；都不可用时明确告警，不假装校验通过。
port_in_use() {
  P="$1"
  if command -v ss >/dev/null 2>&1; then
    ss -ltn 2>/dev/null | grep -qE "[:.]${P}[[:space:]]" && return 0
    return 1
  fi
  # netstat 需先匹配到表头才采信：Windows 版 netstat 格式不同，
  # command -v 判为可用但 grep 恒不命中 → 占用被静默漏判。
  if command -v netstat >/dev/null 2>&1 && netstat -ltn 2>/dev/null | head -3 | grep -qiE 'LISTEN|Proto'; then
    netstat -ltn 2>/dev/null | grep -qE "[:.]${P}[[:space:]]" && return 0
    return 1
  fi
  # /proc/net/tcp 需先匹配首行 sl: local_address 格式才采信：
  # Git Bash / WSL 兼容层 / 部分容器提供**伪 /proc**，文件可读但内容非 netlink 格式。
  if [ -r /proc/net/tcp ] && head -1 /proc/net/tcp 2>/dev/null | grep -qE '^[[:space:]]*[0-9]+:[[:space:]]'; then
    HEXP="$(printf '%04X' "$P")"
    if grep -qiE ":[0-9A-F]*${HEXP}[[:space:]]" /proc/net/tcp 2>/dev/null; then return 0; fi
    if [ -r /proc/net/tcp6 ] && grep -qiE ":[0-9A-F]*${HEXP}[[:space:]]" /proc/net/tcp6 2>/dev/null; then return 0; fi
    return 1
  fi
  return 2   # 无任何可用探测手段
}

RC=0
port_in_use "$PORT" || RC=$?
if [ "$RC" -eq 0 ]; then
  {
    echo "端口 $PORT 已被其它进程占用，安装已中止。"
    echo "请停止占用该端口的服务后重试；如需更换端口，需修改应用包内 manifest 的"
    echo "service_port 后重新打包（桌面图标跳转地址以该字段为准）。"
  } > "$LOGF"
  exit 1
elif [ "$RC" -eq 2 ]; then
  {
    echo "提示：当前系统缺少 ss / netstat，无法自动检测端口 $PORT 是否被占用。"
    echo "若安装完成后无法访问，请在 fnOS 应用中心停止本应用，检查该端口是否被其它服务占用后重试。"
  } >> "$LOGF"
fi

# 持久化端口（供 cmd/main 启动时读取）。
# 写入固定值而非省略：让 cat etc/port 始终有明确输出，便于用户与开发者排查。
echo "$PORT" > "$PORT_FILE"

# 建立终端命令 vditor：
# 主机制：fnOS 的 usr-local-linker 资源会把 app/bin/vditor 软链到 /usr/local/bin/vditor（系统托管，可靠）。
# 兜底机制：这里再尝试把同一个脚本软链到 /usr/bin、/bin（部分环境 /usr/local/bin 可能不在 PATH），
# 并修正执行权限。软链目标指向安装包内持久化的 app/bin/vditor，避免回指临时目录。
TARGET="${TRIM_APPDEST}/bin/vditor"
if [ -f "$TARGET" ]; then
  chmod +x "$TARGET" 2>/dev/null || true
  for BIN_DIR in /usr/bin /usr/local/bin /bin; do
    [ -d "$BIN_DIR" ] || continue
    if ln -sf "$TARGET" "${BIN_DIR}/vditor" 2>/dev/null; then
      echo "已建立软链：${BIN_DIR}/vditor -> $TARGET"
    else
      echo "警告：无法写入 $BIN_DIR，未建立软链（可手动：ln -sf \"$TARGET\" ${BIN_DIR}/vditor）" >&2
    fi
  done
else
  echo "警告：未找到 $TARGET，终端命令 vditor 未建立；可后续通过 usr-local-linker 自动软链到 /usr/local/bin。" >&2
fi

# ---------- 确保服务按固定端口启动 ----------
# fnOS 的执行顺序不保证「先跑本回调、再启动服务」：若服务已用 manifest 默认端口
# 启动过，本回调写入的 port 文件不会被读到。因此这里主动重启一次服务，
# 让 cmd/main 重新读取 port 文件。失败不阻断安装（应用中心通常还会在安装流程末尾自行拉起）。
echo "端口配置已写入 ${PORT_FILE}（值：$PORT），正在重启服务…"
"${TRIM_APPDEST}/cmd/main" stop >/dev/null 2>&1 || true
sleep 1
if "${TRIM_APPDEST}/cmd/main" start >/dev/null 2>&1; then
  echo "服务已按端口 $PORT 启动完成。"
else
  echo "提示：自动重启未成功（不影响安装）。若访问端口不正确，请在 fnOS 应用中心停止后重新启动本应用。" >&2
fi

exit 0
