#!/bin/bash
# cmd/install_callback —— 安装后：读取向导端口与文档目录，写入配置并同步桌面图标端口
set -u

PORT="${wizard_app_port:-3838}"

# 端口合法性校验
if ! echo "$PORT" | grep -Eq '^[0-9]+$' || [ "$PORT" -lt 1 ] || [ "$PORT" -gt 65535 ]; then
  PORT=3838
fi

# 持久化端口（供 cmd/main 启动使用）
echo "$PORT" > "${TRIM_PKGETC}/port"

# 文档存储目录（可留空；留空则用应用私有目录）
DOC_DIR="${wizard_doc_dir:-}"
if [ -n "$DOC_DIR" ]; then
  echo "$DOC_DIR" > "${TRIM_PKGETC}/doc_dir"
fi

# 向导填写的目录**直接落盘为文档分区**（与「设置 → 文件夹设置」同一份配置文件），
# 否则该路径只会作为 VDITOR_DOC_DIR 单目录回退生效，不会出现在左侧分区列表中。
# folders.json 结构： [{"name": 显示名, "path": 绝对路径}, ...]
DOC_PARTITION_NAME="${wizard_doc_partition_name:-}"
if [ -n "$DOC_DIR" ] && [ -d "$DOC_DIR" ]; then
  [ -n "$DOC_PARTITION_NAME" ] || DOC_PARTITION_NAME="我的文档"
  FOLDERS_JSON="${TRIM_PKGETC}/folders.json"
  # 已存在同名路径则不重复写入（同路径只保留一条）
  if ! grep -q "\"path\": *\"$DOC_DIR\"" "$FOLDERS_JSON" 2>/dev/null; then
    printf '[\n  {\n    "name": "%s",\n    "path": "%s"\n  }\n]\n' \
      "$DOC_PARTITION_NAME" "$DOC_DIR" > "$FOLDERS_JSON"
  fi
fi

# 同步桌面图标访问端口（ui/config 中的 "port" 字段）
# 注意路径：ui 目录在应用私有目录**内部**（fnOS 安装后 app/ 被解包到 TRIM_APPDEST，
# 即 ui/ 与 server.py 同级），因此这里用 TRIM_APPDEST 即为正确路径；
# 但为兼容个别环境把 ui 放在 TRIM_APPDEST 之外的情况，两处都尝试一次。
sync_icon_port() {
  for CFG in "${TRIM_APPDEST}/ui/config" "${TRIM_APPDEST}/app/ui/config"; do
    if [ -f "$CFG" ]; then
      if sed -i "s/\"port\"[[:space:]]*:[[:space:]]*\"[0-9]*\"/\"port\": \"$PORT\"/" "$CFG" 2>/dev/null; then
        SYNCED="$SYNCED $CFG"
      fi
    fi
  done
}
SYNCED=""
sync_icon_port
if [ -n "$SYNCED" ]; then
  echo "桌面图标端口已同步为 $PORT：$SYNCED"
else
  echo "警告：未找到 ui/config，桌面图标端口可能仍为默认值 $PORT。" >&2
  echo "如桌面图标打不开，请手动检查应用目录下的 ui/config 中 \"port\" 字段是否为 $PORT。" >&2
fi

# 端口被占用检测：提前告知，避免安装完成后「图标跳转过去却打不开」
# （服务实际监听的端口由 cmd/main 读取本文件决定，此处只做提示，不阻断安装）
if command -v ss >/dev/null 2>&1; then
  if ss -ltn 2>/dev/null | grep -qE "[:.]$PORT[[:space:]]"; then
    echo "提示：端口 $PORT 当前已被占用。若安装后无法访问，请更换端口或在应用中心停止占用该端口的服务。" >&2
  fi
fi

# 建立终端命令 vditor：
# 主机制：fnOS 的 usr-local-linker 资源会把 app/bin/vditor 软链到 /usr/local/bin/vditor（系统托管，可靠）。
# 兜底机制：这里再尝试把同一个脚本软链到 /usr/bin、/bin（部分环境 /usr/local/bin 可能不在 PATH），
# 并修正执行权限。软链目标指向安装包内持久化的 app/bin/vditor，避免回指临时目录。
TARGET="${TRIM_APPDEST}/bin/vditor"
if [ -f "$TARGET" ]; then
  chmod +x "$TARGET" 2>/dev/null || true
  for BIN_DIR in /usr/bin /usr/local/bin /bin; do
    [ -d "$BIN_DIR" ] || continue
    if ln -sf "$TARGET" "${BIN_DIR}/vditor" 2>/dev/null; then
      echo "已建立软链：${BIN_DIR}/vditor -> $TARGET"
    else
      echo "警告：无法写入 $BIN_DIR，未建立软链（可手动：ln -sf \"$TARGET\" ${BIN_DIR}/vditor）" >&2
    fi
  done
else
  echo "警告：未找到 $TARGET，终端命令 vditor 未建立；可后续通过 usr-local-linker 自动软链到 /usr/local/bin。" >&2
fi

# ---------- 确保新端口真正生效 ----------
# fnOS 的执行顺序不保证「先跑本回调、再启动服务」：若服务已用manifest 默认端口
# 启动过，那么本回调写入的 port 文件不会被读到，表现为「图标跳到自定义端口却打不开、
# 仍需用默认端口访问」。因此这里主动重启一次服务，让 cmd/main 重新读取 port 文件。
# 失败不阻断安装（应用中心通常还会在安装流程末尾自行拉起一次服务）。
echo "端口配置已写入 ${TRIM_PKGETC}/port（值：$PORT），正在重启服务以应用该端口…"
"${TRIM_APPDEST}/cmd/main" stop >/dev/null 2>&1 || true
sleep 1
if "${TRIM_APPDEST}/cmd/main" start >/dev/null 2>&1; then
  echo "服务已按端口 $PORT 重启完成。"
else
  echo "提示：自动重启未成功（不影响安装）。若访问端口不正确，请在 fnOS 应用中心停止后重新启动本应用。" >&2
fi

exit 0
