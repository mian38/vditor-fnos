#!/bin/bash
# cmd/main —— 飞牛 FPK 生命周期主脚本：start / stop / status / reset-password
set -u

PID_FILE="${TRIM_PKGVAR}/vditor.pid"
PORT_FILE="${TRIM_PKGETC}/port"
PORT="$(cat "$PORT_FILE" 2>/dev/null || echo 3838)"
APP_DIR="${TRIM_APPDEST}"
LOG="${TRIM_PKGVAR}/vditor.log"

# 优先使用 PATH 中的 python3，回退到常见路径
PY="$(command -v python3 2>/dev/null || echo /usr/bin/python3)"

start() {
  if [ -f "$PID_FILE" ]; then
    old="$(cat "$PID_FILE" 2>/dev/null | tr -d '[:space:]')"
    if [ -n "$old" ] && kill -0 "$old" 2>/dev/null; then
      exit 0
    fi
  fi

  if [ ! -x "$PY" ] && [ ! -f "$PY" ]; then
    echo "未找到 python3，请在飞牛『应用中心』安装 Python3 后重试。" > "$TRIM_TEMP_LOGFILE"
    exit 1
  fi

  cd "$APP_DIR" || { echo "无法进入 $APP_DIR" > "$TRIM_TEMP_LOGFILE"; exit 1; }

  # 文档根目录：优先取历史 doc_dir 文件（1.2.2 及更早版本由安装向导写入，1.2.3 起不再写入，
  # 故新装时该文件不存在），否则用应用私有目录下的 docs。
  DOC_DIR_FILE="${TRIM_PKGETC}/doc_dir"
  DOC_DIR="$(cat "$DOC_DIR_FILE" 2>/dev/null || true)"
  if [ -z "$DOC_DIR" ]; then DOC_DIR="${TRIM_PKGVAR}/docs"; fi
  mkdir -p "$DOC_DIR"

  # 文档分区：优先使用飞牛“访问权限”授权目录(TRIM_DATA_SHARE_PATHS)与 data-share 声明共享目录；
  # 亦可用 VDITOR_DOC_DIRS(名称::路径,逗号分隔) 显式指定多个可访问文件夹。
  # VDITOR_CONFIG 指向 etc 目录，密码哈希(pwhash)持久化于此，重启不丢失。
  VDITOR_PORT="$PORT" \
  VDITOR_UPLOAD_DIR="${TRIM_PKGVAR}/uploads" \
  VDITOR_DOC_DIR="$DOC_DIR" \
  VDITOR_CONFIG="${TRIM_PKGETC}" \
    "$PY" "$APP_DIR/server.py" >>"$LOG" 2>&1 &
  newpid=$!
  echo "$newpid" > "$PID_FILE"

  sleep 2
  if kill -0 "$newpid" 2>/dev/null; then
    exit 0
  fi

  # 端口被占用是「服务起不来」最常见的原因，单独给出可执行的提示。
  # 注意不能只用 $! 判断：进程若因端口占用在 bind阶段即退出，$! 仍是一个已结束的 pid。
  if command -v ss >/dev/null 2>&1 && ss -ltn 2>/dev/null | grep -qE "[:.]$PORT[[:space:]]"; then
    echo "Vditor 启动失败：端口 $PORT 已被其它进程占用。请在 fnOS 应用中心停止占用该端口的服务后重新启动本应用。" > "$TRIM_TEMP_LOGFILE"
    exit 1
  fi

  echo "Vditor 启动失败，请确认已安装 Python3，并查看日志：$LOG" > "$TRIM_TEMP_LOGFILE"
  exit 1
}

stop() {
  if [ -f "$PID_FILE" ]; then
    p="$(cat "$PID_FILE" 2>/dev/null | tr -d '[:space:]')"
    [ -n "$p" ] && kill "$p" 2>/dev/null
    rm -f "$PID_FILE"
  fi
  pkill -f "${APP_DIR}/server.py" 2>/dev/null
  exit 0
}

status() {
  if [ -f "$PID_FILE" ]; then
    p="$(cat "$PID_FILE" 2>/dev/null | tr -d '[:space:]')"
    if [ -n "$p" ] && kill -0 "$p" 2>/dev/null; then
      exit 0
    fi
    rm -f "$PID_FILE"
  fi
  exit 3
}

reset_password() {
  OUT="${TRIM_TEMP_LOGFILE:-/dev/stdout}"
  if [ -z "${TRIM_PKGETC:-}" ]; then
    echo "未检测到应用环境(TRIM_PKGETC)，请在飞牛应用环境中执行，或改用 cmd/reset-password 脚本。" > "$OUT"
    exit 1
  fi
  rm -f "${TRIM_PKGETC}/pwhash"
  echo "已删除密码文件 ${TRIM_PKGETC}/pwhash。" > "$OUT"
  echo "请重启本应用使改动生效（stop 然后 start）。重启后页面将出现『首次设置密码』页，设置新密码即可；文档数据不受影响。" > "$OUT"
  exit 0
}

case "${1:-}" in
  start)  start  ;;
  stop)   stop   ;;
  status) status ;;
  reset-password) reset_password ;;
  *) exit 1 ;;
esac
