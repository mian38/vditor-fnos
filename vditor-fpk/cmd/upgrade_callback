#!/bin/bash
# cmd/upgrade_callback —— 更新后：按方案 B 重置端口为 3838，并确保终端命令软链存在
#
# ============ 1.2.3 变更说明 ============
# 1) 移除 ui/config 的 port 字段同步（原 for 循环 + sed）
#    原因：与 install_callback 中被移除的 sync_icon_port() 同源——**已实测证伪**。
#    真机验证确认桌面图标跳转地址取自应用中心 PostgreSQL appcenter 库的 app 表
#    （安装时一次性写入），改 target/ui/config 无效、重启 trim_app_center.service
#    亦无效。详见 CHANGELOG.md 1.2.3 条目。
#
# 2) 新增：删除历史的 etc/port 文件（方案 B）
#    1.2.2 及更早版本允许通过安装向导自定义端口，但桌面图标与应用中心入口始终
#    指向 manifest 声明的 service_port(3838) —— 这是 fnOS 的限制，非本应用可控。
#    保留用户自定义端口只会导致"图标指向 3838 但服务跑在别处"，图标永远打不开。
#    故升级时统一重置为 3838：一次升级顺带修复图标，用户得到"点了就能开"的系统。
#    这是有意改变用户已有配置，CHANGELOG_USER.md 已明确告知。
set -u

ETC="${TRIM_PKGETC:-}"
APPDEST="${TRIM_APPDEST:-}"

# ① 重置端口：删除历史 port 文件，cmd/main 下次启动时回退到默认 3838
if [ -n "$ETC" ] && [ -f "${ETC}/port" ]; then
  OLD_PORT="$(tr -d '[:space:]' < "${ETC}/port" 2>/dev/null || true)"
  if [ -n "$OLD_PORT" ] && [ "$OLD_PORT" != "3838" ]; then
    if rm -f "${ETC}/port" 2>/dev/null; then
      echo "已将访问端口由 ${OLD_PORT} 重置为默认 3838（桌面图标始终指向 3838）。" \
        > "${TRIM_TEMP_LOGFILE:-/dev/null}"
    else
      echo "警告：无法删除历史端口文件 ${ETC}/port，应用将仍监听 ${OLD_PORT}，桌面图标可能无法打开。" \
        > "${TRIM_TEMP_LOGFILE:-/dev/null}"
    fi
  fi
fi

# ② 建立/修正终端命令软链（幂等，失败容忍）；指向安装包内持久化的 app/bin/vditor
TARGET="${APPDEST}/bin/vditor"
if [ -f "$TARGET" ]; then
  chmod +x "$TARGET" 2>/dev/null || true
  for BIN_DIR in /usr/bin /usr/local/bin /bin; do
    [ -d "$BIN_DIR" ] || continue
    ln -sf "$TARGET" "${BIN_DIR}/vditor" 2>/dev/null || true
  done
fi

exit 0
